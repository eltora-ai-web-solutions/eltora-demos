# Copy to .env for local use (npm start), and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit a real key.

# Required: API key from https://resend.com → API Keys
RESEND_API_KEY=

# Where Contact-page enquiries are delivered
CONTACT_TO_EMAIL=eltora2026@gmail.com

# Sender address. "onboarding@resend.dev" only delivers to the email that owns the Resend account.
# After verifying your own domain in Resend, use e.g.: ELTORA Website <enquiries@yourdomain.com>
FROM_EMAIL=ELTORA Website <onboarding@resend.dev>

# Used by the older /api/enquiry endpoint (kept for compatibility)
TO_EMAIL=eltora2026@gmail.com
